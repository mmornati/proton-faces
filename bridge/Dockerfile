# proton-bridge — wraps the Proton Drive SDK for thumbnail/timeline/full-res access.
#
# The published @protontech/drive-sdk npm package cannot run standalone because its
# authentication module (proton-drive-sdk-account) is not published. The bridge is
# therefore built inside the Proton Drive SDK monorepo at image build time, pinned to
# the commit behind the cli/v0.8.0 tag, reusing the CLI's own init()/auth/crypto
# machinery.
#
# Our code is dropped in on top of the pinned upstream: the HTTP service
# (src/bridge.ts) plus the pure helpers it shares with the tests (src/rateLimit.ts,
# src/helpers.ts), and overlay patches on three upstream files (patches/*.ts).

# Base image pinned by digest — oven/bun:1.2 (bun 1.2.23 as of 2026-09-10).
# Resolve a fresh digest with: docker buildx imagetools inspect oven/bun:1.2
FROM oven/bun:1.2@sha256:6ebf306367da43ad75c4d5119563e24de9b66372929ad4fa31546be053a16f74 AS build

ARG SDK_REPO=https://github.com/ProtonDriveApps/sdk.git
# SDK pinned to the commit behind the cli/v0.8.0 tag (resolved 2026-09-10).
# Keep the ARG so testing can point at a fork; the default must stay a full SHA.
ARG SDK_REF=5491f2eea473acaaa86b5969774b84610a37bd46

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /sdk
# Clone the tag (cheap shallow fetch) then pin the working tree to the exact
# commit SHA. --branch cannot take a raw SHA, hence the two-step form.
RUN git clone --depth 1 --branch cli/v0.8.0 "${SDK_REPO}" . \
    && git checkout --detach "${SDK_REF}"

# Drop our HTTP service into the CLI source tree so it can import ./init etc.
COPY src/bridge.ts cli/src/bridge.ts
COPY src/rateLimit.ts cli/src/rateLimit.ts
COPY src/helpers.ts cli/src/helpers.ts

# Overlay a patched copy of the account SDK's addresses.ts. Upstream
# getOwnPublicKeys() decrypts the address-key token via cryptoProxy.decryptMessage,

#which hangs forever under Bun 1.2 (the WASM OpenPGP proxy), stalling every
# full-resolution download. We import the armored PublicKey directly instead (same as
# the other-user path already does), avoiding the broken decrypt path entirely.
COPY patches/addresses.ts incubating/account/js/src/addresses.ts

# Overlay a patched copy of the downloader so the manifest verification can be
# skipped via env (PROTON_DRIVE_SKIP_MANIFEST_VERIFICATION=1). Address keys for
# migrated accounts often omit the deprecated PublicKey field, so getOwnPublicKeys
# returns no verification keys (see addresses.ts patch); without skipping the manifest
# check, verifyManifest() would then fail after streaming the whole file. Block-level
# integrity (SHA256) still applies when available.
COPY patches/fileDownloader.ts client/js/src/internal/download/fileDownloader.ts

# Overlay a patched copy of the CLI's HTTP transport (cli/src/api/httpClient.ts).
# The SDK routes every upstream HTTPS request through this single class, so
# this is where the PROTON_BRIDGE_RATE_LIMIT_HTTP bucket paces each paginated
# listing, thumbnail request and block download (issue #44). ky's internal
# retry is disabled here so the SDK's own retry loop re-acquires the bucket
# per attempt. See patches/httpClient.ts for the full rationale.
COPY patches/httpClient.ts cli/src/api/httpClient.ts

# The CLI's dependencies are file: links to sibling packages (client/js, incubating/account/js).
# bun resolves those via realpath, so their own deps (ky, ttag, @protontech/crypto, ...) are
# only reachable if the whole monorepo is one bun workspace. Create the root workspace and
# fix the patch path (relative to the workspace root, not the cli dir).
RUN printf '%s\n' \
      '{' \
      '  "name": "proton-drive-sdk-workspace",' \
      '  "private": true,' \
      '  "workspaces": ["cli", "client/js", "incubating/account/js"]' \
      '}' > package.json \
    && sed -i 's|"../config/js/patches/|"./config/js/patches/|' cli/package.json

WORKDIR /sdk
# Root workspace lockfile generated by bun 1.2.23 (see sdk-bun.lock). Kept under
# a separate name so the test-only bridge/bun.lock (used by `bun test` in CI) is
# not clobbered. --frozen-lockfile makes any dependency drift fail the build
# instead of silently resolving a different tree.
COPY sdk-bun.lock bun.lock
RUN bun install --frozen-lockfile

WORKDIR /sdk/cli
# Compile a standalone binary (same mechanism Proton uses to ship the CLI).
RUN bun build src/bridge.ts --compile --target=bun-linux-x64 --outfile=/usr/local/bin/proton-bridge

# --- runtime stage ---
FROM debian:bookworm-slim

# pass + gnupg back the SDK's encrypted credential store
# (PROTON_DRIVE_CREDENTIALS_STORE=pass). They are only exercised when that
# store is selected; the default unsafe_file backend does not need them.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates pass gnupg \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /usr/local/bin/proton-bridge /usr/local/bin/proton-bridge
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

# /secrets holds the pass backend state: the GPG keyring (named volume) and
# the pass store (named volume). Both are mounted only into this container.
# Fresh named volumes inherit the ownership/mode set here, so the UID 1000
# runtime user can write without any host-side setup.
RUN mkdir -p /secrets/gnupg /secrets/password-store \
    && chown -R 1000:1000 /secrets \
    && chmod 700 /secrets/gnupg \
    && chmod 0755 /usr/local/bin/docker-entrypoint.sh

ENV PORT=8090
ENV DATA_DIR=/data
# PROTON_DRIVE_CREDENTIALS_STORE is intentionally NOT baked here — it is set
# per-deployment in compose.yml (proton-bridge service) so operators can
# switch to the SDK's encrypted credential store without rebuilding the
# image. The compose default is `unsafe_file`, matching the historical
# behaviour (the file lives at /data/auth-session.json — see issue #32).
# GNUPGHOME / PASSWORD_STORE_DIR are baked because the container runs as
# UID 1000 with no /etc/passwd entry, so gpg/pass cannot derive them from
# $HOME. They only matter when the `pass` store is selected.
ENV GNUPGHOME=/secrets/gnupg
ENV PASSWORD_STORE_DIR=/secrets/password-store
ENV PROTON_DRIVE_CACHE_DIR=/data
# PROTON_DRIVE_SKIP_MANIFEST_VERIFICATION is intentionally NOT baked into the
# image: it is set per-deployment in compose.yml (proton-bridge service) so the
# E2E manifest/address-key verification downgrade is visible and opt-out-able.
# Remove the flag and the addresses.ts / fileDownloader.ts patches once the
# Bun 1.2 WASM OpenPGP hang (cryptoProxy.decryptMessage) is fixed upstream.
# Tracked in https://github.com/mmornati/proton-faces/issues/39.
# Optional outbound throttle on Proton HTTPS. Default OFF (0). Set e.g. 5 (req/s) to
# protect a small home router/CPE from NAT-table saturation during big syncs.
# Two layers (see bridge/src/rateLimit.ts): the operation layer (below) gates one
# token per bridge operation start; the HTTP layer gates every upstream HTTPS call
# through the patched HTTPClient. ENV is intentionally left EMPTY here (not 0) so the
# HTTP layer DERIVES a default of `PROTON_BRIDGE_RATE_LIMIT x 10` when an operator
# opts into the operation layer; set PROTON_BRIDGE_RATE_LIMIT_HTTP=0 to keep the HTTP
# layer off while keeping the operation layer.
ENV PROTON_BRIDGE_RATE_LIMIT=0
ENV PROTON_BRIDGE_RATE_BURST=10
ENV PROTON_BRIDGE_RATE_LIMIT_HTTP=
# Hard ceiling on a single full-res download. Aborts with 502 if Proton hangs.
ENV PROTON_BRIDGE_FULL_RES_TIMEOUT_MS=300000

# The session/auth files live in DATA_DIR (mounted volume).
VOLUME /data
EXPOSE 8090

USER 1000:1000
WORKDIR /data

# The entrypoint bootstraps the pass credential store (GPG key + pass init +
# one-time plaintext-session migration) when PROTON_DRIVE_CREDENTIALS_STORE=pass,
# then execs the bridge binary as PID 1.
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]