# Where persistent data lives (thumbnails, SQLite index, vectors).
# On a server, point this at a big disk, e.g. /media/12tb/photos-index
DATA_DIR=./data

# Optional: local Google Takeout export (extracted folder). If set, photos that
# exist both locally and on Proton get GPS/EXIF metadata enriched from the local
# files, so you never need a full-res download for location search.
PHOTOS_DIR=

# Compose-level: bind-mount target for the persistent data directory. Defaults
# to Docker's named volume "data". Set to a host path on a big disk on a server:
#   DATA_MOUNT=/srv/proton-faces/data
# The directory must be writable by UID 1000 (the user all containers run as).
# DATA_MOUNT=

# Compose-level: optional read-only bind mount of a local Google Takeout
# export. Inside the indexer/app containers the export is always mounted at
# /takeout (and PHOTOS_DIR is hardcoded to /takeout). Set this on the host so
# compose substitutes the right path, e.g. PHOTOS_MOUNT=/srv/photos-takeout.
# Uncomment to enable.
# PHOTOS_MOUNT=

# Web UI port
PORT=8080

# Seconds between timeline diffs (how often new Proton Photos are picked up).
# Bumped 300 → 600 while Proton Drive is recovering from the Sep 1 partial
# outage — fewer wasted timeline fetches and less log noise. Revert to 300
# once stable if you want faster sync.
SYNC_INTERVAL=600

# Parallel recognition workers. Keep <= (CPU cores - 1) so the API event loop
# always has at least one core. On a busy 4-core host with other containers,
# 3 is a good ceiling; 2 leaves the most room for everything else.
WORKERS=3

# Only index the newest N photos (0 = all). Handy for testing on a big library.
SYNC_LIMIT=0

# Seconds between people-clustering runs
CLUSTER_INTERVAL=1800

# Seconds between automatic GPS/place enrichment runs (default 6 h)
GPS_INTERVAL=21600

# Cosine similarity threshold for auto-tagging similar faces when you name one
FACE_SIM_THRESHOLD=0.45

# Minimum faces needed to form a person cluster. Bumped 2 → 3 to suppress
# 2-face noise clusters (see PR #3). Existing people are NOT retroactively
# affected; only future clustering uses the new threshold.
MIN_CLUSTER_SIZE=3

# HDBSCAN min_samples. Default 1 makes every face a cluster core and produces
# many spurious 2-face "people"; 2 suppresses the worst of it.
MIN_SAMPLES=2

# Grace cycles for the pending_removal status (sync_once only marks a uid as
# 'deleted' once it has been missing from the timeline listing for this many
# consecutive polls). Prevents false deletions when Proton returns a stale /
# partial listing during an incident (e.g. the Aug 27 Frankfurt cooling failure
# + Sep 1 partial outage).
PROTON_SYNC_GRACE_CYCLES=2

# How long a `status='full'` row can sit before being re-queued for full-res
# download. Unsticks videos left stranded by a bridge outage (e.g. the 2,286
# videos left in `full` on Sep 1).
FULLRES_RETRY_AFTER_SEC=600

# Age (seconds) at which the on-disk Proton SDK cache is flagged "stale" by
# the admin Server-checks panel. Stale alone isn't actionable — the check
# only fires when full-res downloads are also failing, which is the
# signature of the getFileDownloader waitForCondition2 hang seen after
# Proton-side incidents (Aug 27 Frankfurt, Sep 1 partial outage).
BRIDGE_CACHE_STALE_SEC=21600

# Outbound rate limit to Proton API. 3 req/s burst 2 keeps us inside Proton's
# comfort zone and avoids the 429 cascade that triggers false-deletions when
# the timeline listing drops rows mid-shard.
PROTON_BRIDGE_RATE_LIMIT=3
PROTON_BRIDGE_RATE_BURST=2

# Bridge container address (internal docker network)
BRIDGE_URL=http://proton-bridge:8090

# Where ML models live (baked into the image; override only for testing)
MODELS_DIR=

# Logging verbosity: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Two-process layout (issue #4): the `app` container serves uvicorn, the
# `indexer` container runs the recognition pipeline. Set RUN_INDEXER=1 to
# fall back to the legacy single-process layout (everything in `app`).
# Default is 0 — leave it off unless you're debugging.
RUN_INDEXER=0

# Internal-only port the `indexer` container binds on (0.0.0.0) to expose
# its live runtime state to the `app` container for the footer/health
# modal. No host port is published in compose, so this is only reachable
# over the compose network via the `indexer` hostname. 8091 by default.
# INDEXER_STATUS_PORT=8091

# Base URL the `app` container reads to proxy the indexer's status
# endpoint. Defaults to http://indexer:8091 (the compose-network DNS name).
# For local single-process dev with RUN_INDEXER=1, override to:
#   INDEXER_STATUS_URL=http://127.0.0.1:8091
# INDEXER_STATUS_URL=http://indexer:8091

# --- multi-user auth (PR-9) ----------------------------------------------
# Bearer-token TTLs. Access tokens are short-lived; refresh tokens survive
# longer so a returning family member doesn't have to log in every day.
# Set AUTH_ACCESS_TTL=0 to make access tokens effectively never expire
# during a single browser session (not recommended).
AUTH_ACCESS_TTL=28800      # 8 hours
AUTH_REFRESH_TTL=2592000   # 30 days

# Max upload size (bytes) for POST /api/search/face. P-03 hardening:
# a 50 MB blob used to be fully buffered into Python memory; 20
# parallel requests spiked to 1 GB. 8 MB is plenty for a face photo.
# FACE_SEARCH_MAX_UPLOAD_BYTES=8388608

# Max decoded pixel count for an image uploaded to /api/search/face.
# Defense against decompression bombs (1.6 MB JPEG → 300 MB raw).
# FACE_SEARCH_MAX_IMAGE_PIXELS=50000000

# P-01: Expose the interactive API docs (/docs, /redoc, /openapi.json).
# Default OFF in public demos (DEMO_HARDENING_MODE=1 flips this off via
# the FastAPI docs_url=None etc.). Set EXPOSE_API_DOCS=1 to re-enable
# (useful when sharing the schema with your own front-end team behind
# a separate auth gate).
# EXPOSE_API_DOCS=1

# P-05: Expose operational details in /api/admin/overview: Docker
# hostname, full platform string, exact disk byte counts. Default OFF
# in public deployments; set EXPOSE_OPERATIONAL_DETAILS=1 to re-enable.
# EXPOSE_OPERATIONAL_DETAILS=1

# Optional: pre-set the first admin's password so --create-admin can run
# non-interactively (e.g. from an init container). If unset, you'll be
# prompted on stdin when you run scripts/create-admin.sh.
# ADMIN_PASSWORD=

# --- DEMO MODE (zero Proton credentials required) --------------------------
# Set DEMO_MODE=1 to run the app with a built-in fixture of free CC0 photos
# instead of talking to a real Proton account. Use this with the `demo`
# compose profile:
#
#   docker compose --profile demo up -d
#
# The app + indexer containers will start with DEMO_MODE=1, the proton-bridge
# service is skipped, and a default admin (username `demo`, password
# `proton-faces` — override with DEMO_ADMIN_PASSWORD) is auto-created on first
# boot. See docs/getting-started/demo-mode.md for details.
# DEMO_MODE=1
# DEMO_ADMIN_PASSWORD=proton-faces