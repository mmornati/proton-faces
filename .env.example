# Where persistent data lives (thumbnails, SQLite index, vectors).
# On a server, point this at a big disk, e.g. /media/12tb/photos-index
DATA_DIR=./data

# Optional: local Google Takeout export (extracted folder). If set, photos that
# exist both locally and on Proton get GPS/EXIF metadata enriched from the local
# files, so you never need a full-res download for location search.
PHOTOS_DIR=

# Web UI port
PORT=8080

# Seconds between timeline diffs (how often new Proton Photos are picked up)
SYNC_INTERVAL=300

# Parallel recognition workers. Keep <= (CPU cores - 1) so the API event loop
# always has at least one core. On a busy 4-core host with other containers,
# 3 is a good ceiling; 2 leaves the most room for everything else.
WORKERS=3

# Only index the newest N photos (0 = all). Handy for testing on a big library.
SYNC_LIMIT=0

# Seconds between people-clustering runs
CLUSTER_INTERVAL=1800

# Seconds between automatic GPS/place enrichment runs (default 6 h)
GPS_INTERVAL=21600

# Cosine similarity threshold for auto-tagging similar faces when you name one
FACE_SIM_THRESHOLD=0.45

# Minimum faces needed to form a person cluster
MIN_CLUSTER_SIZE=2

# Bridge container address (internal docker network)
BRIDGE_URL=http://proton-bridge:8090

# Where ML models live (baked into the image; override only for testing)
MODELS_DIR=

# Logging verbosity: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Two-process layout (issue #4): the `app` container serves uvicorn, the
# `indexer` container runs the recognition pipeline. Set RUN_INDEXER=1 to
# fall back to the legacy single-process layout (everything in `app`).
# Default is 0 — leave it off unless you're debugging.
RUN_INDEXER=0